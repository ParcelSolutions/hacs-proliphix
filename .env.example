# Proliphix Plus — local development / manual testing
# Copy to .env and fill in your thermostat details:
#   cp .env.example .env

# Thermostat connection (required for live API tests)
# Full URL or host:port both work, e.g.:
# PROLIPHIX_PLUS_HOST=http://
PROLIPHIX_PLUS_HOST=192.168.1.10
PROLIPHIX_PLUS_USERNAME=admin
PROLIPHIX_PLUS_PASSWORD=

# Optional: include port if not using default HTTP port
# PROLIPHIX_PLUS_HOST=192.168.1.10:8080

# Integration options (mirror HA config entry options)
PROLIPHIX_PLUS_SCAN_INTERVAL=60
PROLIPHIX_PLUS_AUTO_TIME_SYNC=false
PROLIPHIX_PLUS_HEAT_ONLY=false
